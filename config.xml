<?xml version='1.0' encoding='utf-8'?>
<widget id="com.btb" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>BTB</name>
    <description>Better Than Bet</description>
    <author>BTB</author>

    <content src="index.html" />

    <preference name="BackgroundColor" value="#FF05111F" />
    <preference name="SplashScreenBackgroundColor" value="#05111F" />
    <preference name="SplashScreenDelay" value="1500" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="250" />

    <access origin="*" />
    <allow-navigation href="https://188b143btrial.launchpad.cfapps.us10.hana.ondemand.com/*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/img/logo.png" />
        <resource-file src="google-services.json" target="app/google-services.json" />
        <resource-file src="res/notification/notification_icon.xml" target="app/src/main/res/drawable/notification_icon.xml" />
        <resource-file src="res/images/xxxhdpi.png" target="app/src/main/res/drawable/notification_icon_large.png" />
        <resource-file src="res/notification/btb_super_goal.wav" target="app/src/main/res/raw/btb_super_goal.wav" />
        <resource-file src="res/notification/btb_referee_whistle.wav" target="app/src/main/res/raw/btb_referee_whistle.wav" />
        <allow-intent href="market:*" />

        <icon src="res/images/ldpi.png" density="ldpi" />
        <icon src="res/images/mdpi.png" density="mdpi" />
        <icon src="res/images/hdpi.png" density="hdpi" />
        <icon src="res/images/xhdpi.png" density="xhdpi" />
        <icon src="res/images/xxhdpi.png" density="xxhdpi" />
        <icon src="res/images/xxxhdpi.png" density="xxxhdpi" />
    </platform>

    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
