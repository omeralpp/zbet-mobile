<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/btb_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/btb_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/btb_widget_icon"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:contentDescription="@string/btb_widget_app_icon"
      android:scaleType="fitCenter" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/btb_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/btb_widget_default_title"
        android:textColor="@color/btb_widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btb_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/btb_widget_ready"
        android:textColor="@color/btb_widget_subtle"
        android:textSize="9sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/btb_widget_rating"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:textColor="@color/btb_widget_gold"
      android:textSize="16sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/btb_widget_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="2"
    android:text="@string/btb_widget_default_body"
    android:textColor="@color/btb_widget_text"
    android:textSize="12sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/btb_widget_super"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/btb_widget_secondary_button"
      android:gravity="center"
      android:text="@string/btb_widget_super_log"
      android:textColor="@color/btb_widget_text"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/btb_widget_open"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginHorizontal="8dp"
      android:layout_weight="1"
      android:background="@drawable/btb_widget_primary_button"
      android:gravity="center"
      android:text="@string/btb_widget_open"
      android:textColor="@color/btb_widget_text"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/btb_widget_toto"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/btb_widget_secondary_button"
      android:gravity="center"
      android:text="@string/btb_widget_toto"
      android:textColor="@color/btb_widget_text"
      android:textSize="10sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
