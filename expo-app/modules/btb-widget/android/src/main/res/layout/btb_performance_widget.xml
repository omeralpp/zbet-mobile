<?xml version="1.0" encoding="utf-8"?>
<!-- v40 board "BTB Performans" widget: two columns, each an eyebrow, one
     large figure, a bar and its detail line. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/btb_kpi_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/btb_widget_background"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/btb_kpi_app_icon"
      android:layout_width="26dp"
      android:layout_height="26dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@string/btb_widget_app_icon"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/btb_kpi_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/btb_kpi_widget_title"
      android:textColor="@color/btb_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/btb_kpi_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/btb_widget_ready"
      android:textColor="@color/btb_widget_subtle"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/btb_kpi_toto"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <TextView
        android:id="@+id/btb_kpi_toto_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/btb_kpi_toto_title"
        android:textColor="@color/btb_widget_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btb_kpi_toto_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="@color/btb_widget_blue"
        android:textSize="30sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/btb_kpi_toto_chart"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/btb_kpi_toto_title"
        android:scaleType="fitXY" />

      <TextView
        android:id="@+id/btb_kpi_toto_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:text="@string/btb_kpi_waiting"
        android:textColor="@color/btb_widget_muted"
        android:textSize="11sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/btb_kpi_divider"
      android:layout_width="1dp"
      android:layout_height="match_parent"
      android:layout_marginHorizontal="12dp"
      android:layout_marginVertical="2dp"
      android:background="#FF2E5A6E" />

    <LinearLayout
      android:id="@+id/btb_kpi_super"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <TextView
        android:id="@+id/btb_kpi_super_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/btb_kpi_super_title"
        android:textColor="@color/btb_widget_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btb_kpi_super_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="@color/btb_widget_green"
        android:textSize="30sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/btb_kpi_super_chart"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/btb_kpi_super_title"
        android:scaleType="fitXY" />

      <TextView
        android:id="@+id/btb_kpi_super_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:text="@string/btb_kpi_waiting"
        android:textColor="@color/btb_widget_muted"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
