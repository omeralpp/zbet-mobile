<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/btb_kpi_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/btb_widget_background"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/btb_kpi_app_icon"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@string/btb_widget_app_icon"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/btb_kpi_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/btb_kpi_widget_title"
      android:textColor="@color/btb_widget_text"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/btb_kpi_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/btb_widget_ready"
      android:textColor="@color/btb_widget_subtle"
      android:textSize="9sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/btb_kpi_toto"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:id="@+id/btb_kpi_toto_chart"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@string/btb_kpi_toto_title"
        android:scaleType="fitCenter" />

      <TextView
        android:id="@+id/btb_kpi_toto_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/btb_kpi_toto_title"
        android:textColor="@color/btb_widget_text"
        android:textSize="10sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btb_kpi_toto_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/btb_kpi_waiting"
        android:textColor="@color/btb_widget_muted"
        android:textSize="8sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/btb_kpi_divider"
      android:layout_width="1dp"
      android:layout_height="match_parent"
      android:layout_marginVertical="8dp"
      android:background="#FF173B59" />

    <LinearLayout
      android:id="@+id/btb_kpi_super"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:id="@+id/btb_kpi_super_chart"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@string/btb_kpi_super_title"
        android:scaleType="fitCenter" />

      <TextView
        android:id="@+id/btb_kpi_super_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/btb_kpi_super_title"
        android:textColor="@color/btb_widget_text"
        android:textSize="10sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btb_kpi_super_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/btb_kpi_waiting"
        android:textColor="@color/btb_widget_muted"
        android:textSize="8sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
