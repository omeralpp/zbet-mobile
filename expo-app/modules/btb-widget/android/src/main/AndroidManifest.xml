<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_icon"
      android:resource="@drawable/btb_notification_icon" />
    <meta-data
      android:name="expo.modules.notifications.default_notification_icon"
      android:resource="@drawable/btb_notification_icon" />

    <receiver
      android:name=".BtbNotificationWidgetProvider"
      android:enabled="true"
      android:exported="false"
      android:label="@string/btb_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/btb_widget_info" />
    </receiver>

    <receiver
      android:name=".BtbPerformanceWidgetProvider"
      android:enabled="true"
      android:exported="false"
      android:label="@string/btb_kpi_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/btb_kpi_widget_info" />
    </receiver>
  </application>
</manifest>
