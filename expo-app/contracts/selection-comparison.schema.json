{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "selection-comparison.v1"
    },
    "matchKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "researchOnly": {
      "type": "boolean",
      "const": true
    },
    "autoPromotion": {
      "type": "boolean",
      "const": false
    },
    "availability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "STALE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "snapshotId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceSnapshotId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "asOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "homeScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "awayScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "elapsed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 130
            },
            "period": {
              "type": "string",
              "enum": [
                "1H",
                "2H"
              ]
            },
            "homeRedCards": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "awayRedCards": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\x00-\\x1f]+$"
            }
          },
          "required": [
            "homeScore",
            "awayScore",
            "elapsed",
            "period",
            "homeRedCards",
            "awayRedCards",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3"
            ]
          },
          "modelVersion": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "trialId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\x00-\\x1f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SELECTED",
              "ABSTAIN",
              "UNAVAILABLE",
              "STOPPED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f]+$"
          },
          "selection": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "market": {
                    "type": "string",
                    "enum": [
                      "Ms05a",
                      "Ms05u",
                      "Ms15a",
                      "Ms15u",
                      "Ms25a",
                      "Ms25u",
                      "Ms35a",
                      "Ms35u",
                      "Ms45a",
                      "Ms45u",
                      "Ms1",
                      "MsX",
                      "Ms2",
                      "Ms1X",
                      "MsX2",
                      "H1",
                      "H2",
                      "Kgvar",
                      "Kgyok"
                    ]
                  },
                  "quote": {
                    "type": "number",
                    "exclusiveMinimum": 1,
                    "maximum": 1000
                  },
                  "quoteAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  "quoteRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[^\\x00-\\x1f]+$"
                  },
                  "publicationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[^\\x00-\\x1f]+$"
                  }
                },
                "required": [
                  "market",
                  "quote",
                  "quoteAt",
                  "quoteRef",
                  "publicationId"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "probability": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "probabilityValidation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "const": "OUT_OF_TIME_REVIEWED"
                  },
                  "reportSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "method",
                  "reportSha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedNet": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "form": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "snapshotSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "homeN": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "awayN": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "homeVenueN": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "awayVenueN": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "snapshotSha256",
                  "homeN",
                  "awayN",
                  "homeVenueN",
                  "awayVenueN"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "explanationCodes": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "modelVersion",
          "trialId",
          "status",
          "reason",
          "selection",
          "probability",
          "probabilityValidation",
          "expectedNet",
          "form",
          "explanationCodes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "matchKey",
    "researchOnly",
    "autoPromotion",
    "availability",
    "reason",
    "snapshotId",
    "sourceSnapshotId",
    "asOf",
    "expiresAt",
    "state",
    "proposals"
  ],
  "additionalProperties": false,
  "$comment": "Structural contract. Cross-field snapshot, arm, chronology, price/payoff and validation invariants are enforced by selectionComparisonSchema and the BFF publication validator."
}
