# Public runtime configuration only. Never put secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_MOBILE_API_URL=
# preview (mocks), pilot (direct-open), or oauth (production user identity).
# Non-mock builds default to oauth; pilot must always be selected explicitly.
EXPO_PUBLIC_MOBILE_AUTH_MODE=preview
# Rotatable direct-open pilot gate. It is extractable from the APK and must
# never be a SAP, Identity, Cloudflare, or Firebase credential.
EXPO_PUBLIC_MOBILE_PILOT_KEY=

# Provider-neutral public OIDC metadata. Authorization/token endpoints may stay
# empty when the issuer publishes standard discovery metadata.
EXPO_PUBLIC_AUTH_CLIENT_ID=
EXPO_PUBLIC_AUTH_ISSUER=
EXPO_PUBLIC_AUTH_AUTHORIZATION_ENDPOINT=
EXPO_PUBLIC_AUTH_TOKEN_ENDPOINT=
EXPO_PUBLIC_AUTH_REDIRECT_URI=https://api.surklase.com/auth/callback
EXPO_PUBLIC_AUTH_REVOCATION_ENDPOINT=
EXPO_PUBLIC_AUTH_END_SESSION_ENDPOINT=
EXPO_PUBLIC_AUTH_SCOPES=openid offline_access mobile.read mobile.device.write
EXPO_PUBLIC_LEGACY_LAUNCHPAD_URL=https://example.invalid/site
EXPO_PUBLIC_SAP_WEB_ALLOWED_HOSTS=*.hana.ondemand.com,*.accounts.ondemand.com

# Local/EAS build-only path to the preview Firebase client configuration.
# This file must match the preview application id and must not contain a
# Firebase service-account private key.
BTB_GOOGLE_SERVICES_FILE=
