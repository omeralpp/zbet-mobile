# Public runtime configuration only. Never put secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_MOBILE_API_URL=
EXPO_PUBLIC_AUTH_CLIENT_ID=
EXPO_PUBLIC_AUTH_AUTHORIZATION_ENDPOINT=
EXPO_PUBLIC_AUTH_TOKEN_ENDPOINT=
EXPO_PUBLIC_AUTH_REDIRECT_URI=https://api.surklase.com/auth/callback
EXPO_PUBLIC_AUTH_REVOCATION_ENDPOINT=
EXPO_PUBLIC_AUTH_SCOPES=openid profile email groups offline_access
EXPO_PUBLIC_LEGACY_LAUNCHPAD_URL=https://example.invalid/site

# Local/EAS build-only path to the preview Firebase client configuration.
# This file must match the preview application id and must not contain a
# Firebase service-account private key.
BTB_GOOGLE_SERVICES_FILE=
