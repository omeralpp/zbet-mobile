<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btb_kpi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/btb_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/btb_kpi_widget_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="@string/btb_kpi_widget_title"
            android:textColor="@color/btb_widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btb_kpi_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btb_widget_ready"
            android:textColor="@color/btb_widget_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btb_kpi_toto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btb_kpi_toto_chart"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@string/btb_kpi_toto_title"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/btb_kpi_toto_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btb_kpi_toto_title"
                android:textColor="@color/btb_widget_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btb_kpi_toto_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btb_kpi_waiting"
                android:textColor="@color/btb_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:background="#26FFFFFF" />

        <LinearLayout
            android:id="@+id/btb_kpi_super"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btb_kpi_super_chart"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@string/btb_kpi_super_title"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/btb_kpi_super_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btb_kpi_super_title"
                android:textColor="@color/btb_widget_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btb_kpi_super_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btb_kpi_waiting"
                android:textColor="@color/btb_widget_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
